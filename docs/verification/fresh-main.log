theorem Tusnady.main_lower_bound_unconditional : Tusnady.HigherDimensionalLowerBound :=
Tusnady.main_lower_bound Tusnady.LiteratureProof.assumptionsProved
'Tusnady.main_lower_bound_unconditional' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem Tusnady.main_lower_bound_real_colorings_unconditional : ∀ (d : ℕ),
  3 ≤ d →
    ∃ c,
      0 < c ∧
        ∃ N₀,
          1 ≤ N₀ ∧
            ∀ (N : ℕ),
              N₀ ≤ N →
                ∃ P,
                  Function.Injective P ∧
                    (Finset.image P Finset.univ).card = N ∧
                      ∀ (χ : Fin N → ℝ),
                        Tusnady.IsSignColoring χ →
                          ∃ x, c * (Real.log ↑N).rpow (↑d - 1 / 2) ≤ |∑ i ∈ Tusnady.trace P x, χ i| :=
Tusnady.main_lower_bound_real_colorings Tusnady.LiteratureProof.assumptionsProved
'Tusnady.main_lower_bound_real_colorings_unconditional' depends on axioms: [propext, Classical.choice, Quot.sound]
def Tusnady.HigherDimensionalLowerBound : Prop :=
∀ (d : ℕ),
  3 ≤ d → ∃ c, 0 < c ∧ ∃ N₀, 1 ≤ N₀ ∧ ∀ (N : ℕ), N₀ ≤ N → c * Tusnady.targetGrowth d N ≤ Tusnady.worstDiscrepancy d N
