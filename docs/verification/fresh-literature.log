theorem Tusnady.LiteratureProof.rosenblattUniform : Tusnady.Literature.RosenblattUniform :=
fun M f s =>
  Eq.symm
    (MeasureTheory.Measure.pi_eq fun E hE =>
      Eq.mpr
        (id
          (congrArg (fun _a => _a = ∏ i, MeasureTheory.volume[E i | Set.Icc (-1) 1])
            (MeasureTheory.Measure.map_apply (Tusnady.ConditionalDensitySystem.measurable_cdfTransform s)
              (MeasurableSet.univ_pi hE))))
        (let A := s.cdfTransform ⁻¹' Set.univ.pi E;
        have hA :=
          MeasurableSet.preimage (MeasurableSet.univ_pi hE)
            (Tusnady.ConditionalDensitySystem.measurable_cdfTransform s);
        have hprod := fun z =>
          id
            (have hi := Tusnady.LiteratureProof.indicator_product E (s.cdfTransform z);
            Eq.mpr
              (id
                (congrArg (Eq (∏ i, Tusnady.LiteratureProof.indicatorOne (E i) (s.cdfTransform z i)))
                  (Set.indicator_apply A (fun x => 1) z)))
              (Eq.mp
                (congrArg (Eq (∏ i, Tusnady.LiteratureProof.indicatorOne (E i) (s.cdfTransform z i)))
                  (Set.indicator_apply (Set.univ.pi E) (fun x => 1) (s.cdfTransform z)))
                hi));
        have hint :=
          Eq.mpr
            (id
              (congrArg (fun x => MeasureTheory.integral s.law x = s.law.real A)
                (funext fun z => (fun z => hprod z) z)))
            (MeasureTheory.integral_indicator_one hA);
        have hreal := Eq.trans (Eq.symm (Tusnady.LiteratureProof.prefixProduct_integral s M le_rfl E hE)) hint;
        have hmeasure :=
          Eq.mpr (id (congrArg (fun _a => s.law A = ENNReal.ofReal _a) (MeasureTheory.measureReal_def s.law A)))
            (Eq.mpr
              (id (congrArg (fun _a => s.law A = _a) (ENNReal.ofReal_toReal (MeasureTheory.measure_ne_top s.law A))))
              (Eq.refl (s.law A)));
        id
          (Eq.mpr (id (congrArg (fun _a => _a = ∏ i, MeasureTheory.volume[E i | Set.Icc (-1) 1]) hmeasure))
            (Eq.mpr
              (id
                (congrArg (fun _a => ENNReal.ofReal _a = ∏ i, MeasureTheory.volume[E i | Set.Icc (-1) 1])
                  (Eq.symm hreal)))
              (Eq.mpr
                (id
                  (congrArg (fun x => ENNReal.ofReal x = ∏ i, MeasureTheory.volume[E i | Set.Icc (-1) 1])
                    (Finset.prod_congr (Eq.refl Finset.univ) fun x a =>
                      Eq.refl (Tusnady.UniformMonomial.scalarLaw (E ⟨↑x, lt_of_lt_of_le x.isLt le_rfl⟩)).toReal)))
                (Eq.mpr
                  (id
                    (congrArg (fun _a => ENNReal.ofReal _a = ∏ i, MeasureTheory.volume[E i | Set.Icc (-1) 1])
                      (Eq.symm ENNReal.toReal_prod)))
                  (ENNReal.ofReal_toReal
                    (LT.lt.ne
                      (ENNReal.prod_lt_top fun i x =>
                        MeasureTheory.measure_lt_top Tusnady.UniformMonomial.scalarLaw (E i))))))))))
