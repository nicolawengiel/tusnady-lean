theorem Tusnady.LiteratureProof.sampling : Tusnady.Literature.Sampling :=
Exists.intro Tusnady.Frame.selectionConstant
  (Exists.intro (25 / Tusnady.Frame.selectionConstant)
    (Exists.intro Tusnady.Frame.selectionConstant
      ⟨Tusnady.Frame.selectionConstant_pos,
        ⟨div_pos
            (Mathlib.Meta.NormNum.isNat_lt_true (Mathlib.Meta.NormNum.isNat_ofNat ℝ Nat.cast_zero)
              (Mathlib.Meta.NormNum.isNat_ofNat ℝ (Eq.refl 25)) (Eq.refl false))
            Tusnady.Frame.selectionConstant_pos,
          ⟨Tusnady.Frame.selectionConstant_pos, fun ambient D hD Ω _hΩ μ hμ u humeas hint horth hE =>
            Exists.casesOn
              (Tusnady.LiteratureSampling.exists_finite_frame_approximation μ u hD humeas hint horth hE (201 * D))
              fun M h =>
              And.casesOn h fun hM right =>
                And.casesOn right fun hmin right =>
                  Exists.casesOn right fun ξ h =>
                    And.casesOn h fun hnorm henergy =>
                      Exists.casesOn
                        (Tusnady.Frame.exists_small_subset (Tusnady.LiteratureSampling.nodeVector u ξ) hD hM hmin hnorm
                          henergy)
                        fun S h =>
                        And.casesOn h fun hcardlow right =>
                          And.casesOn right fun hcardup hS =>
                            Exists.intro S.card
                              ⟨LT.lt.trans_le hD hcardlow,
                                ⟨hcardup,
                                  Exists.intro (fun j => ξ (Tusnady.LiteratureSampling.selectedIndex S j)) fun a =>
                                    have hh :=
                                      Tusnady.LiteratureSampling.selected_average_bounds u ξ hD hM S
                                        Tusnady.Frame.selectionConstant Tusnady.Frame.selectionConstant_pos hcardlow
                                        hcardup hS a;
                                    Eq.mpr (id (congrArg ⋯ ⋯)) hh⟩⟩⟩⟩⟩))
